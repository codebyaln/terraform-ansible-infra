
[bastion]
bastion ansible_host=<BASTION_PUBLIC_IP> ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-key.pem

[master]
master ansible_host=<MASTER_PRIVATE_IP> ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-key.pem

[workers]
worker1 ansible_host=<WORKER1_PRIVATE_IP> ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-key.pem
worker2 ansible_host=<WORKER2_PRIVATE_IP> ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-key.pem
worker3 ansible_host=<WORKER3_PRIVATE_IP> ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-key.pem

[jfrog]
jfrog ansible_host=<JFROG_PUBLIC_IP> ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-key.pem
